create or replace table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.site_battery_analysis_jun2024` as (
  Select *,
     CASE
      WHEN ((COALESCE(mean_2std, 0) + COALESCE(replace_cat, 0))  > est_spare_bid )  THEN 1
    ELSE
     0
    END AS site_need_battery
   from(
SELECT
*,round((avg_swaps +2*std_swaps),0) as mean_2std,
(round(total_bid-avg_bid_used,0) + total_spare_bid ) as est_spare_bid
from `comb_data1`
order by site_name,device_date )order by site_name,device_date );



