create or replace  table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.battery_morning_shift_jun_2024` as (
Select serialnumber,bid,device_date,device_hour,last_battery_val_adj,total_sn_cnt,age_bid_years,last_battery_temp_val,
last_battery_val_adj - (LAG(last_battery_val_adj)  over (order by serialnumber,bid,device_date,device_hour) ) as diff_prev_dayhour
from(
Select serialnumber,bid,device_date,device_hour,total_sn_cnt,curr_date,battery_manufacturing_date
    ,round(date_diff(curr_date,battery_manufacturing_date,day)/365,2) as age_bid_years,last_battery_temp_val,
     CASE
      WHEN (last_battery_val > 100 )  THEN 100
    ELSE
     last_battery_val
    END AS last_battery_val_adj
   from(
SELECT
    _e AS serialnumber,CONCAT(battery_partnumber, battery_manufacturing_date, battery_serial_number) AS bid,
    extract(date from TIMESTAMP_MILLIS(_r)) AS device_date,
    extract(hour from TIMESTAMP_MILLIS(_r)) as device_hour,
    extract(minute from TIMESTAMP_MILLIS(_r)) as device_min,
    battery_level,ac_line_status,
    safe_CAST(battery_manufacturing_date AS DATE)  as battery_manufacturing_date,
    safe_CAST("2024-06-30" AS DATE) as curr_date,
    COUNT(DISTINCT(_e)) OVER(PARTITION BY EXTRACT(date FROM TIMESTAMP_MILLIS(_r))) AS total_sn_cnt,
    last_value(battery_level) over (partition by _e,extract(date from TIMESTAMP_MILLIS(_r)),extract(hour from TIMESTAMP_MILLIS(_r))  
    order by extract(minute from TIMESTAMP_MILLIS(_r)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as last_battery_val,
    (battery_temperature/10) as battery_temperature,
    max((battery_temperature/10)) over (partition by _e,extract(date from TIMESTAMP_MILLIS(_r)),extract(hour from TIMESTAMP_MILLIS (_r))  order by extract(minute from TIMESTAMP_MILLIS(_r)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as last_battery_temp_val  
   
  FROM
    `es-s2dl-core-p.emc_eu.t_zagent_battery`
  WHERE
    DATE(_et) between "2024-06-01" and "2024-06-30"
    AND DATE(TIMESTAMP_MILLIS(_r))   between "2024-06-01" and "2024-06-30"
    -- and _e in ("21217522506340","21241522503081","21206522509643")
    AND CONCAT(battery_partnumber, battery_manufacturing_date, battery_serial_number) != "UnknownUnknownUnknown"
  ORDER BY serialnumber,device_date, device_hour ASC)  
  group by serialnumber,bid,device_date,device_hour,last_battery_val_adj,total_sn_cnt,curr_date,battery_manufacturing_date,last_battery_temp_val
  --order by serialnumber,bid,device_date,device_hour
  ) );
 
 create or replace  table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.battery_morning_shift_jun2024` as (
Select  * from dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.battery_morning_shift_jun_2024
 where device_hour between 7 and 15 and diff_prev_dayhour < 0
 --order by  serialnumber,bid,device_date,device_hour
 );
 
 
create or replace TEMP table temp1 as (
Select  * from dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.battery_morning_shift_jun2024
 where device_hour between 7 and 15 and diff_prev_dayhour < 0
 --order by  serialnumber,bid,device_date,device_hour
 );
 
 create or replace TEMP table temp2 as (
 select * ,  LAG(last_battery_val_adj) over (partition by serialnumber,bid,device_date order by device_hour) as prev_val
from temp1
--order by serialnumber,bid,device_date,device_hour
);
 
create or replace TEMP table temp3 as (
 select * ,
 case when last_battery_val_adj <= prev_val
    then 'DECREASING'
  when last_battery_val_adj > prev_val
   then 'INCREASING'
 else 'No Change' end CORRECT_ORDER
from temp2
--order by serialnumber,bid,device_date,device_hour
);
--Remove data where the bid reentered after the charging in the morning shift
create or replace TEMP table temp4 as (
 select * ,  min(device_hour) over (partition by serialnumber,bid,device_date order by device_hour) as first_incr_hour
from temp3
where CORRECT_ORDER = "INCREASING"
--order by serialnumber,bid,device_date,device_hour
);
 
create or replace  table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.battery_morning_shift_jun2024`  as ( select * from (
 select a.* , COALESCE(first_incr_hour, 25) as first_incr_hour
from temp3 as a left join temp4 as b
on a. serialnumber = b.serialnumber and a.bid=b.bid and a.device_date=b.device_date
--order by serialnumber,bid,device_date,device_hour) where device_hour< first_incr_hour
));
